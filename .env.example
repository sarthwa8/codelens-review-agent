# Copy to .env and fill in. docker-compose.yml already wires DATABASE_URL, REDIS_URL and CHROMA_*.
# Full walkthrough: README.md → "Run it".

# ─── GitHub App ──────────────────────────────────────────────────────────────────────────────
# From your App's settings page (github.com/settings/apps/<your-app>).
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
# Download a private key from the App settings and save it as secrets/github-app.pem
GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
# The "Webhook secret" you set on the App.
GITHUB_WEBHOOK_SECRET=

# Where you open CodeLens in the browser. Must match the App's callback URL: <PUBLIC_URL>/auth/callback
PUBLIC_URL=http://localhost:3000

# ─── Sign-in ─────────────────────────────────────────────────────────────────────────────────
# github: everyone signs in with GitHub and only sees repositories they can read.
# none:   no sign-in (local experiments only).
AUTH_MODE=github
# 32+ random characters, e.g. from: openssl rand -hex 32
SESSION_SECRET=

# ─── LLM ─────────────────────────────────────────────────────────────────────────────────────
# fake | groq | anthropic | openai | ollama
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Groq's free tier allows ~8K tokens/minute per request budget; raise these on a paid plan.
GROQ_MAX_PROMPT_CHARS=12000
GROQ_MAX_OUTPUT_TOKENS=1800

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ─── Behaviour ───────────────────────────────────────────────────────────────────────────────
# github: GitHub API (normal use) | local: read repos from ./.demo-repos (offline demo)
SOURCE_MODE=github
# Also review pushes to branches that already have an open pull request (default: PR only).
REVIEW_PUSHES_WITH_OPEN_PR=false
# RAG embeddings: default (local ONNX MiniLM) | openai | hashing (offline, lexical)
EMBEDDING_PROVIDER=default
