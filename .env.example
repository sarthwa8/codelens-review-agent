# Copy to .env and adjust. docker-compose.yml already wires DATABASE_URL, REDIS_URL, CHROMA_*.

# --- Required ---
# Must match the secret configured on the GitHub webhook (Settings → Webhooks).
GITHUB_WEBHOOK_SECRET=change-me

# --- Source of commits ---
# github: GitHub REST API (set GITHUB_TOKEN for private repos / higher rate limits)
# local:  read git repos from ./.demo-repos/<owner>/<name> (offline demo + replay benchmark)
SOURCE_MODE=github
GITHUB_TOKEN=

# --- LLM provider: fake | anthropic | openai | ollama ---
# "fake" streams a deterministic review with no API key — good for trying the stack.
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Ollama running on the host machine:
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:7b
LLM_MAX_OUTPUT_TOKENS=2048

# --- RAG embeddings: default (local ONNX MiniLM) | openai | hashing (lexical, offline) ---
EMBEDDING_PROVIDER=default

# --- API ---
# If set, /api/* requires "Authorization: Bearer <token>" (or ?token= for SSE).
API_TOKEN=
